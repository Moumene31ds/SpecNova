rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Device media: public CDN read, pipeline-only write.
    match /devices/{slug}/media/{asset} {
      allow read: if true;
      allow write: if false;
    }

    // Uploads go through the scrape pipeline's signed URLs only.
    match /uploads/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
