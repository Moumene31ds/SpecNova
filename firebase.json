{
  "firestore": {
    "rules": "functions/firestore.rules",
    "indexes": "functions/firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "specnova-pipeline",
      "runtime": "nodejs22"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}
