{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specnova",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    // Optional: uncomment to enable ISR/incremental-cache persistence.
    // Create the bucket once:  npx wrangler r2 bucket create specnova-cache
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "specnova-cache"
    // }
  ],
  "vars": {
    "NEXTJS_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
