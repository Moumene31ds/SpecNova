# ============================================================
# SpecNova — Environment Variables
# Copy to .env.local for local dev. All values required.
# ============================================================

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Firebase (browser SDK) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=specnova.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=specnova
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=specnova.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- Firebase Admin SDK (server) ---
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"specnova",...}

# --- next-firebase-auth-edge ---
FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false

# --- Google AI / Gemini ---
GEMINI_API_KEY=AIza...
# Optional — override the extraction model (default: gemini-3.5-flash)
AI_EXTRACTION_MODEL=gemini-3.5-flash

# --- Admin Studio (RBAC / security) ---
# First account to promote to admin. Set once, call
# POST /api/admin/bootstrap while signed in as this user, then clear.
ADMIN_BOOTSTRAP_EMAIL=
# Require TOTP second-factor on admin sessions (recommended in production).
REQUIRE_ADMIN_MFA=false

# --- Distributed rate limiting (optional — in-memory fallback otherwise) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Firebase App Check (reCAPTCHA Enterprise) ---
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=6Le...

# --- Functions (mirrored into functions/.env at deploy) ---
FUNCTIONS_WEBHOOK_SECRET=openssl rand -hex 32
PRICE_SOURCE_AMAZON_KEY=
PRICE_SOURCE_ALIEXPRESS_KEY=

# --- Vercel-only ---
CRON_SECRET=openssl rand -hex 32
